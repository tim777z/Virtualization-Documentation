# EditorConfig for Virtualization-Documentation
# https://editorconfig.org

root = true

[*]
# Default settings for all files
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
# Markdown files
indent_size = 2
trim_trailing_whitespace = false

[*.yml, *.yaml]
# YAML files (CI workflows, docker-compose)
indent_size = 2

[*.json]
# JSON files (package.json, config files)
indent_size = 2

[*.ps1, *.psm1, *.psd1]
# PowerShell scripts and modules
indent_size = 4

[*.sql]
# SQL scripts
indent_size = 4

[*.xml, *.config]
# XML/Web.config files
indent_size = 2

[*.txt, *.md, *.markdown]
# Text and markdown - allow longer lines
max_line_length = 0

[Dockerfile*]
# Dockerfiles
indent_size = 4

[Makefile]
# Makefiles use tabs
indent_style = tab

[*.{sh,bash,zsh}]
# Shell scripts
indent_size = 2
end_of_line = lf