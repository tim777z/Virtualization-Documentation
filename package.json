{
  "name": "virtualization-documentation",
  "version": "1.0.0",
  "description": "Documentation and sample code for Microsoft Windows virtualization and container technologies",
  "private": true,
  "scripts": {
    "lint:md": "markdownlint-cli \"**/*.md\" --ignore node_modules --ignore \".git\"",
    "lint:md:fix": "markdownlint-cli \"**/*.md\" --ignore node_modules --ignore \".git\" --fix",
    "test": "npm run lint:md",
    "test:ci": "npm run lint:md",
    "prepare": "npm run lint:md"
  },
  "devDependencies": {
    "markdownlint-cli": "^0.41.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.8.2"
}