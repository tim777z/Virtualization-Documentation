# Copy this file to `.env` and adjust the values for your environment.
# The `docker-compose.yml` file reads these variables automatically.
#
# NOTE: The SQL Server 2014 Express Windows container image used by this
# sample requires the sa password to meet SQL Server complexity policy
# (at least 8 characters, upper/lower case letters, digits and symbols).

# Password for the SQL Server 'sa' account (used by the db service and the
# web application's connection string).
DB_PASSWORD=Password123

# Name of the blog database created by db/Setup-blogdatabase.sql.
DB_NAME=blogengine_db

# Host name of the db service as seen from the web service.
DB_HOST=db

# SQL Server user id used by the web application connection string.
DB_USER=sa