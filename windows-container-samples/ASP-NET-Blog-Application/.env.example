# Copy this file to `.env` and adjust the values for your environment.
# The `docker-compose.yml` file reads these variables automatically.
#
# ⚠️  SECURITY WARNING: Never commit the actual `.env` file to version control!
#     Add `.env` to your `.gitignore` (already configured in this repo).
#
#     The SQL Server container requires the SA password to meet SQL Server
#     complexity policy: at least 8 characters with uppercase, lowercase,
#     digits, AND symbols. Example: P@ssw0rd!2024
#
#     For production, use a secrets manager (Azure Key Vault, HashiCorp Vault,
#     AWS Secrets Manager, Docker Secrets) instead of environment variables.

# Password for the SQL Server 'sa' account (used by the db service and the
# web application's connection string).
# MUST meet SQL Server complexity: 8+ chars, upper, lower, digit, symbol
# Generate with: openssl rand -base64 32 | tr -d "=+/" | cut -c1-24
DB_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# Name of the blog database created by db/Setup-blogdatabase.sql.
DB_NAME=blogengine_db

# Host name of the db service as seen from the web service.
DB_HOST=db

# SQL Server user id used by the web application connection string.
DB_USER=sa